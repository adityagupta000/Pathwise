# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing / coverage
/coverage

# next.js build output
/.next/
/out/
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env*
!.env.example

# deployment
.vercel

# typescript artifacts (not used but emitted by some tools)
*.tsbuildinfo
next-env.d.ts

# Python remnants from old OCR service
pdf.py
venv/
__pycache__/
*.pyc

# PDFs — keep test fixtures
*.pdf
!tests/fixtures/*.pdf

# Old backend service (removed)
backend/
