# Required. Create a key at https://dashboard.sarvam.ai/key-management
SARVAM_API_KEY=

# Optional (defaults shown)
# SARVAM_CHAT_MODEL=sarvam-105b      # model used for the structured extraction step
# SARVAM_MAX_TOKENS=4096             # raise if you see "response was cut off"
# SARVAM_PARSE_TIMEOUT_MS=180000     # max wait for one OCR job
# RATE_LIMIT_PER_10_MIN=10           # analyses per IP per 10 minutes
# TRANSLATE_LIMIT_PER_10_MIN=120     # translations per IP per 10 minutes

# Security: Rate limiting IP detection
# Set to 'true' if behind a trusted reverse proxy (Railway, Render, Vercel)
# Set to 'false' if directly exposed to the internet (default: false)
# TRUST_PROXY=false
